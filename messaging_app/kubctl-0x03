#!/bin/bash

echo "Triggering Rolling Update to Version 2.0..."
kubectl apply -f blue_deployment.yaml

# 2. Monitor the update progress
echo "Waiting for rollout to complete..."
kubectl rollout status deployment/messaging-app-blue

# 3. Test for downtime using Port-Forwarding
echo "Setting up temporary tunnel for testing..."
kubectl port-forward service/messaging-app-service 8081:80 > /dev/null 2>&1 &
PF_PID=$!

sleep 3

echo "Testing connectivity..."
curl -I http://127.0.0.1:8081
echo "Test finished."

kill $PF_PID

echo "Verifying Pods..."
kubectl get pods